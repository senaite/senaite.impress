<tal:t define="collection python:view.collection;
               report_options python:options.get('report_options', {});
               show_conditions python:bool(report_options.get('show_conditions', True));
               show_accreditation view/show_accreditation;"
       i18n:domain="senaite.impress">

  <tal:model repeat="model collection">

    <!-- Sample header -->
    <tal:summary replace="structure python:view.render_summary(context, model=model, **options)"/>

    <div class="row section-results no-gutters"
         tal:define="footnotes python:[];
                     show_uncertainty python:view.has_uncertainties(model);
                     show_specs python:view.has_specifications(model);
                     columns python:4 + int(show_uncertainty) + int(show_specs);">
      <div class="w-100">
        <table class="results">
          <colgroup>
            <col style="width:31%"/>
            <col style="width:12%"/>
            <col tal:condition="show_uncertainty" style="width:9%"/>
            <col style="width:10%"/>
            <col tal:condition="show_specs" style="width:11%"/>
            <col/>
          </colgroup>
          <thead>
            <tr>
              <th i18n:translate="">Parameter</th>
              <th class="num" i18n:translate="">Result</th>
              <th class="num" tal:condition="show_uncertainty" i18n:translate="">U</th>
              <th i18n:translate="">Unit</th>
              <th class="num" tal:condition="show_specs" i18n:translate="">Range</th>
              <th i18n:translate="">Method</th>
            </tr>
          </thead>
          <tbody>
            <tal:poc repeat="poc python:view.get_analyses_by_poc(model)">
              <tal:category define="categories_by_poc python:view.get_categories_by_poc(model)"
                            repeat="category python:view.sort_items(categories_by_poc.get(poc))">
                <tal:analyses define="analyses python:view.get_analyses_by(model, poc=poc, category=category)"
                              condition="analyses">

                  <!-- Category row -->
                  <tr class="category">
                    <td tal:attributes="colspan columns"
                        tal:content="category/Title">Category</td>
                  </tr>

                  <!-- Analysis rows -->
                  <tal:analysis repeat="analysis analyses">
                  <tal:comment define="range_comment python:view.get_range_comment(model, analysis)">
                  <tr tal:attributes="class python:' '.join(filter(None, ['out-of-range' if model.is_out_of_range(analysis) else '', 'has-range-comment' if range_comment else ''])) or None">
                    <tal:row define="symbol python:view.get_out_of_range_symbol(model, analysis);
                                     notes python:(show_conditions and view.get_analysis_conditions(analysis) or []) + view.get_result_variables(analysis);
                                     dummy python:notes and footnotes.append(notes);">
                      <td>
                        <span class="accredited symbol"><tal:accredited
                          condition="python:show_accreditation and analysis.Accredited">★</tal:accredited></span>
                        <span tal:attributes="class python:'font-italic' if analysis.ScientificName else None"
                              tal:content="analysis/title">Analysis</span>
                        <sup tal:condition="notes"
                             tal:content="python:len(footnotes)">1</sup>
                      </td>
                      <td class="num">
                        <span class="result"
                              tal:content="structure python:model.get_formatted_result(analysis)">23</span>
                        <span class="flag symbol"
                              tal:condition="symbol"
                              tal:content="symbol">▲</span>
                        <span class="retest"
                              tal:condition="python:model.is_retest(analysis)">RT</span>
                      </td>
                      <td class="num" tal:condition="show_uncertainty">
                        <tal:u define="u python:model.get_uncertainty(analysis)"
                               condition="u">&plusmn;&nbsp;<span tal:replace="u"/></tal:u>
                      </td>
                      <td class="unit"
                          tal:content="structure python:model.get_formatted_unit(analysis)">mg/l</td>
                      <td class="num" tal:condition="show_specs"
                          tal:content="python:model.get_formatted_specs(analysis)">50 - 60</td>
                      <td class="method"
                          tal:content="structure python:view.hyphenize(analysis.getMethodTitle() or '')">Method</td>
                    </tal:row>
                  </tr>

                  <!-- Comment of the specification for results out of range -->
                  <tr class="range-comment"
                      tal:condition="range_comment">
                    <td tal:attributes="colspan columns"
                        tal:content="range_comment">Comment</td>
                  </tr>
                  </tal:comment>
                  </tal:analysis>

                  <!-- Category comments -->
                  <tr class="category-comment" tal:condition="category/Comments">
                    <td tal:attributes="colspan columns"
                        tal:content="category/Comments">Comments</td>
                  </tr>

                </tal:analyses>
              </tal:category>
            </tal:poc>
          </tbody>
        </table>

        <!-- Footnotes of this sample -->
        <div class="footnotes" tal:condition="footnotes">
          <div tal:repeat="notes footnotes">
            <span class="key" tal:content="repeat/notes/number">1</span>
            <tal:note repeat="note notes">
              <span tal:content="python:view.format_footnote(note, last=repeat['note'].end)">Title: Value Unit;</span>
            </tal:note>
          </div>
        </div>
      </div>
    </div>

  </tal:model>
</tal:t>
