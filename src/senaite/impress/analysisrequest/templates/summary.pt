<tal:t define="model options/model|view/model;
               sample_code python:view.get_report_option(options, 'sample_code');
               sample_point model/SamplePoint|nothing;
               info python:view.get_sample_info(model);"
       i18n:domain="senaite.impress">

  <div class="row section-sample no-gutters">
    <div class="w-100">

      <!-- Sample header with ID, type, point and machine readable code -->
      <table class="sample-band">
        <tr>
          <td class="ident">
            <div class="sample-id mono" tal:content="model/getId">W-0001</div>
            <div class="what">
              <b tal:content="model/SampleType/title|nothing">Water</b>
              <tal:point condition="sample_point">
                &middot; <span tal:replace="sample_point/title">Sample Point</span>
              </tal:point>
              <tal:csid condition="model/ClientSampleID">
                &middot; <span i18n:translate="">Client SID</span>
                <b tal:content="model/ClientSampleID">CSID</b>
              </tal:csid>
              <tal:cref condition="model/ClientReference|nothing">
                &middot; <span i18n:translate="">Client Reference</span>
                <b tal:content="model/ClientReference">CREF</b>
              </tal:cref>
            </div>
          </td>
          <td class="code" tal:condition="python:sample_code != 'none'">
            <div class="barcode"
                 tal:condition="python:sample_code == 'barcode'"
                 data-code="code128"
                 data-showHRI="false"
                 data-barHeight="30"
                 data-addQuietZone="false"
                 tal:attributes="data-id model/getId">
            </div>
            <div class="qrcode-box"
                 tal:condition="python:sample_code == 'qrcode'">
              <div class="qrcode"
                   data-size="120"
                   data-color="#1b2328"
                   tal:attributes="data-text model/absolute_url">
              </div>
            </div>
          </td>
        </tr>
      </table>

      <!-- Sample details, only filled values -->
      <table class="sample-info" tal:condition="info">
        <tr tal:repeat="row python:view.group_into_chunks(info, 3)">
          <td tal:repeat="item row">
            <span class="label" tal:content="item/label">Label</span>
            <span tal:content="item/value">Value</span>
          </td>
        </tr>
      </table>

    </div>
  </div>

</tal:t>
