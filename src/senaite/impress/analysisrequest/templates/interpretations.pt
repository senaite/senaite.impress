<tal:t define="collection python:view.collection;
               interpretations python:[(m, m.get_resultsinterpretation()) for m in collection];
               interpretations python:[(m, filter(lambda ri: ri.get('richtext'), ris)) for m, ris in interpretations];
               interpretations python:[(m, ris) for m, ris in interpretations if ris];"
       condition="interpretations"
       i18n:domain="senaite.impress">

  <div class="row section-block section-resultsinterpretation no-gutters">
    <div class="w-100">
      <h2 i18n:translate="">Results Interpretation</h2>
      <tal:model repeat="item interpretations">
        <tal:ri define="model python:item[0]" repeat="ri python:item[1]">
          <h3>
            <span class="mono" tal:content="model/getId">W-0001</span>
            <tal:dept condition="ri/title|nothing">
              &middot; <span tal:replace="ri/title">Department</span>
            </tal:dept>
          </h3>
          <div tal:content="structure ri/richtext">Interpretation</div>
        </tal:ri>
      </tal:model>
    </div>
  </div>

</tal:t>
