<tal:t define="collection python:view.collection;
               analyses_by_poc python:view.get_analyses_by_poc(collection);
               categories_by_poc python:view.get_categories_by_poc(collection);
               show_accreditation view/show_accreditation;
               columns python:len(collection) + 1;"
       i18n:domain="senaite.impress">

  <div class="row section-results no-gutters">
    <div class="w-100">

      <!-- Results table per point of capture -->
      <tal:poc repeat="poc analyses_by_poc">
        <h2 class="poc-title"
            tal:condition="python:len(analyses_by_poc) > 1"
            tal:content="python:view.points_of_capture.get(poc)">Lab Analyses</h2>

        <table class="results transposed">
          <colgroup>
            <col style="width:28%"/>
            <col tal:repeat="model collection"/>
          </colgroup>
          <thead>
            <tr>
              <th i18n:translate="">Parameter</th>
              <th class="num mono"
                  tal:repeat="model collection"
                  tal:content="model/getId">W-0001</th>
            </tr>
          </thead>
          <tbody>
            <tal:category repeat="category python:view.sort_items(categories_by_poc.get(poc))">
              <tal:analyses define="analyses python:view.get_analyses_by(collection, poc=poc, category=category);
                                    keywords python:view.uniquify_items(map(lambda a: a.getKeyword(), analyses));
                                    first_by_keyword python:dict(map(lambda a: (a.getKeyword(), a), reversed(analyses)));"
                            condition="analyses">

                <!-- Category row -->
                <tr class="category">
                  <td tal:attributes="colspan columns"
                      tal:content="category/Title">Category</td>
                </tr>

                <!-- One row per analysis keyword -->
                <tr tal:repeat="keyword keywords">
                  <td tal:define="first python:first_by_keyword[keyword]">
                    <span class="accredited symbol"><tal:accredited
                      condition="python:show_accreditation and first.Accredited">★</tal:accredited></span>
                    <span tal:attributes="class python:'font-italic' if first.ScientificName else None"
                          tal:content="first/Title">Analysis</span>
                    <div class="method"
                         tal:define="method_title python:first.getMethodTitle()"
                         tal:condition="method_title"
                         tal:content="structure python:view.hyphenize(method_title)">Method</div>
                  </td>

                  <!-- Result of each sample, the latest reported one wins -->
                  <td class="num"
                      tal:repeat="model collection">
                    <tal:analysis define="analyses python:view.get_analyses_by(model, keyword=keyword)[-1:]"
                                  repeat="analysis analyses">
                      <tal:result define="out_of_range python:model.is_out_of_range(analysis);
                                          symbol python:view.get_out_of_range_symbol(model, analysis);
                                          uncertainty python:model.get_uncertainty(analysis);">
                        <span tal:attributes="class python:'result out-of-range' if out_of_range else 'result'"
                              tal:content="structure python:model.get_formatted_result(analysis)">23</span>
                        <span class="flag symbol" tal:condition="symbol" tal:content="symbol">▲</span>
                        <span class="retest" tal:condition="python:model.is_retest(analysis)">RT</span>
                        <div class="uncertainty" tal:condition="uncertainty">
                          &plusmn;&nbsp;<span tal:replace="uncertainty"/>
                        </div>
                        <div class="unit"
                             tal:content="structure python:model.get_formatted_unit(analysis)">mg/l</div>
                      </tal:result>
                    </tal:analysis>
                  </td>
                </tr>

              </tal:analyses>
            </tal:category>
          </tbody>
        </table>
      </tal:poc>

    </div>
  </div>

</tal:t>
