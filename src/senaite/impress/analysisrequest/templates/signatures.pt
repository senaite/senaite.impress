<tal:t define="release_mode python:view.get_report_option(options, 'release_mode');
               show_signatures python:release_mode in ['signatures', 'both'];
               show_statement python:release_mode in ['electronic', 'both'];
               responsibles view/get_responsibles;"
       i18n:domain="senaite.impress">

  <div class="row section-block section-release no-gutters">
    <div class="w-100">
      <h2 i18n:translate="">Release</h2>

      <!-- Verifying persons -->
      <table class="signatures"
             tal:condition="python:show_signatures and responsibles">
        <tr tal:repeat="row python:view.group_into_chunks(responsibles, 3)">
          <td tal:repeat="person row">
            <img class="signature"
                 tal:condition="person/signature_url"
                 tal:attributes="src person/signature_url"/>
            <div class="who" tal:content="person/fullname">Name</div>
            <div class="role" tal:content="person/jobtitle">Job Title</div>
          </td>
        </tr>
      </table>

      <!-- Electronic release statement -->
      <div class="e-release" tal:condition="show_statement" i18n:translate="">
        This test report was released electronically by
        <tal:block replace="view/get_publisher_fullname" i18n:name="publisher"/>
        on
        <tal:block replace="python:view.to_localized_time(view.timestamp)" i18n:name="date"/>
        and is valid without signature.
      </div>
    </div>
  </div>

</tal:t>
