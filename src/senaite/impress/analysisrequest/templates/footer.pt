<tal:t define="footer python:view.get_footer_text();"
       i18n:domain="senaite.impress">

  <!-- End of report marker -->
  <div class="row no-gutters">
    <div class="w-100 end-of-report" i18n:translate="">End of test report</div>
  </div>

  <!-- The default footer is rendered in the page margins, see css.pt.
       A custom footer text from the control panel replaces the
       laboratory address on the left side of every page. -->
  <div class="section-footer" tal:condition="footer">
    <div tal:replace="structure footer"/>
  </div>

</tal:t>
