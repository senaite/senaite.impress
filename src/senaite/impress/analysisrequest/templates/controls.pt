<tal:t define="report_options python:options.get('report_options', {});
               attachments_per_row python:int(report_options.get('attachments_per_row', 2));
               show_remarks python:bool(report_options.get('show_remarks', False));
               show_conditions python:bool(report_options.get('show_conditions', True));"
       i18n:domain="senaite.impress">

  <!-- Custom Report Controls -->
  <div id="controls" class="noprint">
    <a href="#" style="text-decoration:none;" data-toggle="collapse" data-target="#report-controls">
      <span class="fas fa-cogs"></span>
      <span i18n:translate="" class="text-secondary mb-2">
        Report Options
      </span>
    </a>
    <div id="report-controls"
         tal:attributes="class python:report_options and 'collapse show mt-2' or 'collapse mt-2'">
      <!-- Show Remarks -->
      <div class="mb-3">
        <div class="input-group">
          <div class="custom-control custom-checkbox">
            <input tal:attributes="checked python:show_remarks" name="show_remarks" type="checkbox" class="custom-control-input" id="show-remarks">
            <label class="custom-control-label" for="show-remarks">
              Remarks
            </label>
          </div>
        </div>
        <small class="form-text text-muted" i18n:translate="">
          Show Sample Remarks
        </small>
      </div>
      <!-- Show analysis conditions -->
      <div class="mb-3">
        <div class="input-group">
          <div class="custom-control custom-checkbox">
            <input tal:attributes="checked python:show_conditions" name="show_conditions" type="checkbox" class="custom-control-input" id="show-conditions">
            <label class="custom-control-label" for="show-conditions">
              Analysis conditions
            </label>
          </div>
        </div>
        <small class="form-text text-muted" i18n:translate="">
          Display the analysis conditions with the 'Report' option selected as footnotes below the results table.
        </small>
      </div>
      <!-- Sample code -->
      <div class="mb-3"
           tal:define="sample_code python:view.get_report_option(options, 'sample_code')">
        <div class="input-group">
          <div class="input-group-prepend">
            <label class="input-group-text" for="sample_code" i18n:translate="">
              Sample Code
            </label>
          </div>
          <select class="custom-select" name="sample_code" id="sample_code">
            <option tal:repeat="choice python:view.get_choices('senaite.impress.vocabularies.SampleCodes')"
                    tal:attributes="value choice/value;
                                    selected python:choice['value'] == sample_code or None"
                    tal:content="choice/title">Barcode</option>
          </select>
        </div>
        <small class="form-text text-muted" i18n:translate="">
          Machine readable code shown next to each sample
        </small>
      </div>
      <!-- Report release -->
      <div class="mb-3"
           tal:define="release_mode python:view.get_report_option(options, 'release_mode')">
        <div class="input-group">
          <div class="input-group-prepend">
            <label class="input-group-text" for="release_mode" i18n:translate="">
              Release
            </label>
          </div>
          <select class="custom-select" name="release_mode" id="release_mode">
            <option tal:repeat="choice python:view.get_choices('senaite.impress.vocabularies.ReleaseModes')"
                    tal:attributes="value choice/value;
                                    selected python:choice['value'] == release_mode or None"
                    tal:content="choice/title">Signatures</option>
          </select>
        </div>
        <small class="form-text text-muted" i18n:translate="">
          Show the signatures of the verifying persons, an electronic release statement, or both
        </small>
      </div>
      <!-- Accreditation logo -->
      <div class="mb-3"
           tal:define="accreditation_logo python:view.get_report_option(options, 'accreditation_logo')">
        <div class="input-group">
          <div class="input-group-prepend">
            <label class="input-group-text" for="accreditation_logo" i18n:translate="">
              Accreditation Logo
            </label>
          </div>
          <select class="custom-select" name="accreditation_logo" id="accreditation_logo">
            <option tal:repeat="choice python:view.get_choices('senaite.impress.vocabularies.AccreditationLogo')"
                    tal:attributes="value choice/value;
                                    selected python:choice['value'] == accreditation_logo or None"
                    tal:content="choice/title">Automatic</option>
          </select>
        </div>
        <small class="form-text text-muted" i18n:translate="">
          Automatic shows the accreditation logo and statement only for final reports with accredited analyses
        </small>
      </div>
      <!-- Attachments per row -->
      <div class="mb-3">
        <div class="input-group">
          <div class="input-group-prepend">
            <label class="input-group-text" for="attachments_per_row" i18n:translate="">
              Attachments per Row
            </label>
          </div>
          <input tal:attributes="value attachments_per_row"
                 type="number"
                 class="form-control"
                 name="attachments_per_row"
                 min="1"/>
        </div>
        <small class="form-text text-muted" i18n:translate="">
          Number of attachments rendered within one row per Analysis Request
        </small>
      </div>
    </div>
  </div>

</tal:t>
