<tal:t define="collection view/collection;
               laboratory python:view.laboratory;
               legend view/get_legend;"
       i18n:domain="senaite.impress">

  <!-- Legend of the symbols used in the results -->
  <div class="row section-block section-legend no-gutters"
       tal:condition="legend">
    <div class="w-100">
      <h2 i18n:translate="">Legend</h2>
      <table class="legend">
        <tr tal:repeat="item legend">
          <td class="symbol" tal:content="item/symbol">★</td>
          <td tal:content="item/text">Accredited method</td>
        </tr>
      </table>
    </div>
  </div>

  <!-- Statements that apply to every test report -->
  <div class="row section-fine no-gutters">
    <div class="w-100">
      <div i18n:translate="">
        The results relate only to the samples tested, in the condition
        in which they were received.
      </div>
      <div i18n:translate="">
        This document shall not be reproduced except in full, without the
        written approval of
        <tal:block replace="laboratory/title" i18n:name="name_lab"/>.
      </div>
      <div tal:define="confidence laboratory/Confidence"
           tal:condition="confidence"
           i18n:translate="">
        Test results are at a
        <tal:block replace="confidence" i18n:name="lab_confidence"/>%
        confidence level.
      </div>
      <div tal:condition="python:all(map(lambda m: m.InvoiceExclude, collection))"
           i18n:translate="">
        Not invoiced
      </div>
    </div>
  </div>

</tal:t>
