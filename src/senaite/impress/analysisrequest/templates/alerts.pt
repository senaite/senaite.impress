<tal:t define="collection view/collection;
               invalid python:filter(lambda m: m.is_invalid(), collection);
               provisional python:filter(lambda m: m.is_provisional() and not m.is_invalid(), collection);"
       condition="python:invalid or provisional"
       i18n:domain="senaite.impress">

  <div class="row section-alerts no-gutters">
    <div class="w-100">

      <!-- Invalidated samples -->
      <div class="alert-line" tal:condition="invalid">
        <b i18n:translate="">Invalid Report</b>
        <div tal:repeat="model invalid">
          <b class="mono" tal:content="string:${model/getId}:">W-0001:</b>
          <span i18n:translate="">This sample has been invalidated due to erroneously published results.</span>
          <tal:retest define="retest python:model.getRetest()"
                      condition="retest">
            <span i18n:translate="">It has been replaced by</span>
            <b class="mono" tal:content="string:${retest/getId}.">W-0001-R01.</b>
          </tal:retest>
        </div>
      </div>

      <!-- Samples with provisional results -->
      <div class="alert-line provisional" tal:condition="provisional">
        <b i18n:translate="">Provisional Report</b>
        <div>
          <span i18n:translate="">The results of the following samples are provisional and not yet verified:</span>
          <b class="mono"
             tal:content="python:', '.join(map(lambda m: m.getId(), provisional))">W-0001, W-0002</b>
        </div>
      </div>

    </div>
  </div>

</tal:t>
