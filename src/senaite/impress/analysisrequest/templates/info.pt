<tal:t define="model python:view.model;
               collection view/collection;
               client model/Client;
               batch model/Batch;
               laboratory python:view.laboratory;"
       i18n:domain="senaite.impress">

  <div class="row section-info no-gutters">
    <div class="w-100">
      <table class="parties">
        <tr>
          <!-- Client address -->
          <td>
            <div class="label" i18n:translate="">Client</div>
            <div class="addr">
              <div class="name" tal:content="client/Name|nothing">Client</div>
              <div tal:define="contact python:view.get_contact_fullname(model)"
                   tal:condition="contact"
                   tal:content="contact">Contact</div>
              <div tal:repeat="line python:view.get_client_address(model)"
                   tal:content="line">Street</div>
            </div>
          </td>
          <!-- Report facts -->
          <td>
            <table class="facts">
              <tr>
                <td class="key" i18n:translate="">Revision</td>
                <td tal:content="view/get_report_revision">1</td>
              </tr>
              <tr tal:condition="batch">
                <td class="key" i18n:translate="">Batch</td>
                <td class="mono" tal:content="batch/getId">B-0001</td>
              </tr>
              <tr tal:condition="batch/ClientBatchID|nothing">
                <td class="key" i18n:translate="">Client Batch ID</td>
                <td tal:content="batch/ClientBatchID"></td>
              </tr>
              <tr tal:condition="model/ClientOrderNumber|nothing">
                <td class="key" i18n:translate="">Client Order</td>
                <td tal:content="model/ClientOrderNumber"></td>
              </tr>
              <tr>
                <td class="key" i18n:translate="">Samples</td>
                <td tal:content="python:len(collection)">1</td>
              </tr>
            </table>

            <!-- Accreditation -->
            <div class="accreditation"
                 tal:condition="view/show_accreditation"
                 tal:define="logo_url view/get_accreditation_logo_url">
              <img tal:condition="logo_url" tal:attributes="src logo_url"/>
              <span i18n:translate="">
                Accredited by
                <tal:block replace="laboratory/AccreditationBody" i18n:name="accreditation_body"/>
                according to
                <tal:block replace="python:laboratory.Accreditation or 'ISO/IEC 17025'" i18n:name="accreditation_standard"/>.
                Accredited methods are marked with
                <span class="symbol" i18n:name="symbol">★</span>.
              </span>
              <span tal:condition="laboratory/AccreditationReference"
                    tal:content="laboratory/AccreditationReference">D-PL-00000</span>
            </div>
          </td>
        </tr>
      </table>
    </div>
  </div>

</tal:t>
