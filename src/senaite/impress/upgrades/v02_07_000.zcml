<?xml version="1.0" encoding="utf-8"?>
<configure
    xmlns="http://namespaces.zope.org/zope"
    xmlns:genericsetup="http://namespaces.zope.org/genericsetup"
    i18n_domain="senaite.impress">

  <!-- Remove the setting to store multi-reports individually -->
  <genericsetup:upgradeStep
      title="Remove the multi-report storage setting"
      description="Multi-reports are stored once in the primary sample"
      source="2704"
      destination="2705"
      handler="senaite.impress.upgrades.v02_07_000.remove_store_individually_registry"
      profile="senaite.impress:default" />

  <!-- Register the decision rule, empty for existing sites -->
  <genericsetup:upgradeStep
      title="Add the decision rule to the registry"
      description="Register the decision rule field, empty for existing sites"
      source="2703"
      destination="2704"
      handler="senaite.impress.upgrades.v02_07_000.add_decision_rule_registry"
      profile="senaite.impress:default" />

  <!-- Import registry for sample code and release mode -->
  <genericsetup:upgradeStep
      title="Import registry"
      description="Register sample code and report release fields"
      source="2702"
      destination="2703"
      handler="senaite.impress.upgrades.v02_07_000.import_registry"
      profile="senaite.impress:default" />

  <!-- Import registry for custom paper formats -->
  <genericsetup:upgradeStep
      title="Import registry"
      description="Register custom paper formats and
                   template format mapping"
      source="2701"
      destination="2702"
      handler="senaite.impress.upgrades.v02_07_000.import_paperformats_registry"
      profile="senaite.impress:default" />

  <!-- Import registry for report logo field -->
  <genericsetup:upgradeStep
      title="Import registry"
      description="Register report logo field"
      source="2700"
      destination="2701"
      handler="senaite.impress.upgrades.v02_07_000.import_report_logo_registry"
      profile="senaite.impress:default" />

</configure>
